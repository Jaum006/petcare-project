# Endereço da API do PetCare (copie este arquivo para .env e ajuste).
# Use o IP do computador na rede local (Wi-Fi), NÃO use "localhost":
# no celular, "localhost" aponta para o próprio celular.
# Descubra o IP com "ipconfig" (Windows) ou "ip addr" (Linux/macOS).
# O celular e o computador precisam estar na mesma rede Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3333/api
