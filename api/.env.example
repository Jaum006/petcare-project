# Copie este arquivo para .env e ajuste os valores. O .env não deve ser versionado.

# Porta HTTP da API
PORT=3333

# Banco de dados. Em desenvolvimento usamos SQLite (arquivo local).
# Em produção (PostgreSQL), troque o provider no prisma/schema.prisma e use:
# DATABASE_URL="postgresql://usuario:senha@host:5432/petcare"
DATABASE_URL="file:./dev.db"

# Chave usada para assinar os tokens JWT. Gere uma chave longa e aleatória, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Validade do token de acesso
JWT_EXPIRES_IN="8h"

# Senha dos usuários de teste criados pelo seed (npm run db:seed)
SEED_SENHA_PADRAO="petcare123"
